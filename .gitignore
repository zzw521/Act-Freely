# 本地工具链（JDK / Maven 等自行下载的运行时）
.tools/

# Dependencies
node_modules/

# Build outputs
dist/
target/

# Secrets & local config
.env
.env.local

# 含明文 API Key 的临时验证脚本，禁止入库（其中的 Key 需尽快吊销轮换）
tongtian-tauri/tests/test.py

# Logs & temp
*.log
.DS_Store

# Python 运行产物与 Auth 服务运行时数据
__pycache__/
auth.db

# 引擎本地会话数据（含真实对话内容，不入版本库）
# 注：sessions/ 是引擎按 --work-dir 落盘的真实会话目录，之前只写了 .tools/ 与注释不符，
# 导致开发/测试在源码树里跑引擎时生成的 sessions/ 一直以未跟踪状态裸露在 git status 里。
tongtian-tauri/sessions/
tongtian-tauri/.tools/

# Qoder hooks 的运行时审计日志
.qoder/hooks/logs/

# 根目录临时截图（验证产物放 .qoder/canvases/）
/*.png

# tauri-bundler 生成的 WiX 源文件（candle/light 编译产物，非源码）
tongtian-tauri/src-tauri/*.wxs

# 随包 Python 运行时（scripts/prepare-python.sh 生成，200MB 级二进制，不入库）
tongtian-tauri/vendor/

# 早期探索遗留的 embeddable 压缩包（已被 scripts 中带 SHA 校验的下载取代）
tongtian-tauri/src-tauri/vendor/
