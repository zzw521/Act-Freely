# 复制为 .env 后按需修改。
# 生产环境（TT_GATEWAY_ENV=production）强制 RS256/JWKS，缺项直接拒绝启动。

TT_GATEWAY_ENV=development
TT_GATEWAY_HOST=127.0.0.1
TT_GATEWAY_PORT=8001
TT_GATEWAY_ID=gw-local-01
# 数据目录（存 gateway.db、密钥密文与策略缓存）
TT_GATEWAY_DATA_DIR=./storage

# 同机多 worker（M5）：1–64，默认 1。>1 时必须配置 TT_GATEWAY_REDIS_URL，
# 所有 worker 共用同一 DATA_DIR 与 GATEWAY_ID。
TT_GATEWAY_WORKERS=1
# 共享热状态（令牌桶/在途预留/并发计数/策略失效通知）；redis:// 或 rediss://
# 连接串只从环境变量读取，不写日志。多 worker 缺此项或 PING 失败拒绝启动。
TT_GATEWAY_REDIS_URL=
# 同机多套网关实例必须使用不同前缀
TT_GATEWAY_REDIS_PREFIX=ttgw
# Redis 命令超时（毫秒，100–5000）；超时按不可用处理，限流/配额失败关闭
TT_GATEWAY_REDIS_TIMEOUT_MS=500
# Redis 认证与库号（URL 里已带密码/库号时以 URL 为准）
TT_GATEWAY_REDIS_PASSWORD=
TT_GATEWAY_REDIS_DB=0

# Redis 高可用（M6）：配置 MASTER 名后经 Sentinel 发现主节点，URLS 为
# host:port,host:port；生产至少 3 个 Sentinel。留空则用 TT_GATEWAY_REDIS_URL 直连。
TT_GATEWAY_REDIS_SENTINEL_MASTER=
TT_GATEWAY_REDIS_SENTINEL_URLS=
# Sentinel 自身认证（业务 Redis 密码用上面的 TT_GATEWAY_REDIS_PASSWORD）
TT_GATEWAY_REDIS_SENTINEL_PASSWORD=
# TLS：设 1，或直接把 URL 写成 rediss://（会强制开启）。CA 文件必填；
# CERT/KEY 成对出现时做双向认证。地址与凭据同样只从环境变量读取，不写日志。
TT_GATEWAY_REDIS_TLS=0
TT_GATEWAY_REDIS_TLS_CA=
TT_GATEWAY_REDIS_TLS_CERT=
TT_GATEWAY_REDIS_TLS_KEY=

# 跨主机多副本（M6）
# Postgres 共享账本（配额/审计链/outbox）；地址与密码只从环境变量读取，
# 健康页只披露后端模式。留空时用本地 SQLite（单副本）。
TT_GATEWAY_DB_URL=
# =1 时要求 Postgres + 共享状态；各副本使用同一 GATEWAY_ID、各自独立 DATA_DIR
TT_GATEWAY_CROSS_HOST=0

# 令牌校验：生产用 rs256；HS256 仅供内网联调
TT_GATEWAY_JWT_MODE=hs256-dev
TT_GATEWAY_DEV_HS256_SECRET=tongtian-dev-secret-change-me
TT_GATEWAY_JWT_ISSUER=tongtian-auth
TT_GATEWAY_JWT_AUDIENCE=tongtian-gateway
# RS256 模式下的公钥地址；留空时由 CONTROL_PLANE_URL 推导
TT_GATEWAY_JWKS_URL=

# 管理 API 共享密钥（X-TT-Admin-Token）；生产必须单独配置
TT_GATEWAY_ADMIN_TOKEN=dev-admin-token

# 管理面 mTLS（M2）：proxy = 采信受信反向代理写入的 X-TT-Client-Verify/ DN；off = 关闭
# 生产默认 proxy；显式 off 会打印告警。开发默认 off。
TT_GATEWAY_MTLS_MODE=
# 受信反向代理地址（IP/CIDR，逗号分隔）；proxy 模式为空或非法会拒绝启动
TT_GATEWAY_TRUSTED_PROXIES=127.0.0.1,::1
# 管理面限流（M2）：每证书 DN / 对端 IP 每分钟请求数与令牌桶容量；0 关闭
# 生产默认 120 / 40（默认 burst = max(10, RPM/3)）；开发默认 0 / 0。
TT_GATEWAY_ADMIN_RATE_LIMIT_PER_MINUTE=
TT_GATEWAY_ADMIN_RATE_LIMIT_BURST=

# 控制面地址与策略拉取：配置后按租户从控制面拉取，未配置时读本地策略文件或内置默认策略
TT_GATEWAY_CONTROL_PLANE_URL=
# 网关服务令牌，与控制面 TT_GATEWAY_SERVICE_TOKEN 一致
# 与 CONTROL_PLANE_URL 同时配置时：既拉策略，也批量上报用量（见下方 USAGE_*）
TT_GATEWAY_SERVICE_TOKEN=
TT_GATEWAY_POLICY_FILE=
TT_GATEWAY_POLICY_TTL_SECONDS=300
TT_GATEWAY_POLICY_STALE_GRACE_SECONDS=86400

# 网关从不落 prompt / response，日志只有元数据

# 限额与超时
TT_GATEWAY_MAX_REQUEST_BYTES=33554432
TT_GATEWAY_MAX_OUTPUT_TOKENS=8192
# 连接上游 / 上游整段响应 / 流式两帧空闲（秒）
TT_GATEWAY_CONNECT_TIMEOUT_SECONDS=10
TT_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=120
TT_GATEWAY_STREAM_IDLE_TIMEOUT_SECONDS=120
# 同一 provider 内的有限重试次数（0 关闭）；只重试限流/不可用/超时，尊重 Retry-After
TT_GATEWAY_UPSTREAM_RETRIES=1

# 用量批量上报：每 FLUSH_SECONDS 秒推一批，单批最多 BATCH_SIZE 条；失败指数退避重试
TT_GATEWAY_USAGE_BATCH_SIZE=200
TT_GATEWAY_USAGE_FLUSH_SECONDS=5

# 本地 vLLM / Ollama 需要显式放开私网地址
TT_GATEWAY_ALLOW_PRIVATE_PROVIDERS=false

# 厂商密钥加密主密钥（M1 起必填）：base64 编码的 32 字节，生成示例见 README
TT_GATEWAY_MASTER_KEY=
# 当前加密用的主密钥版本；密文里会记录版本，轮换时调大即可
TT_GATEWAY_MASTER_KEY_VERSION=1
# 历史主密钥环，JSON：{"1":"<base64-32字节>","2":"<base64-32字节>"}；轮换后仍需保留旧版本用于解密
TT_GATEWAY_MASTER_KEYS=
