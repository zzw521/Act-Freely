# 复制为 .env 后按需修改；init.sh 启动时会自动加载。
# 生产环境务必配置独立的 JWT 密钥，并将服务放在 TLS 反向代理之后。

# 运行环境：development / production
TT_SERVER_ENV=development
TT_SERVER_HOST=127.0.0.1
TT_SERVER_PORT=8000
# 数据目录（SQLite 与市场包文件），相对路径按启动目录解析
TT_SERVER_DATA_DIR=./storage

# 生产环境必须设置（建议：python -c "import secrets; print(secrets.token_hex(32))"）
TT_SERVER_JWT_SECRET=
TT_ACCESS_TTL_SECONDS=900
TT_REFRESH_TTL_SECONDS=2592000

# 注册开关与跨域来源（多个来源用逗号分隔；生产环境不建议使用 *）
TT_ALLOW_REGISTRATION=true
TT_CORS_ORIGINS=*
TT_TRUST_PROXY=false

# 演示数据：开发阶段默认由 init.sh 开启；设为 false 使用干净数据库
TT_SEED_DEMO=true
# 演示账号密码仅在首次创建时生效；留空则随机生成并打印一次
TT_DEMO_PASSWORD=

# 管理员引导：两者必须同时配置，密码至少 8 位。
# 已存在账号只会被提升为 admin，不会修改其密码与昵称。
TT_ADMIN_EMAIL=
TT_ADMIN_PASSWORD=
TT_ADMIN_NICKNAME=平台管理员

# 套件/技能包校验上限（一般无需调整）
TT_MAX_ZIP_BYTES=16777216
TT_MAX_ZIP_ENTRIES=256
TT_MAX_ENTRY_BYTES=4194304
TT_MAX_UNCOMPRESSED_BYTES=33554432
TT_MAX_MANIFEST_BYTES=262144
TT_MAX_SKILL_MD_BYTES=524288
