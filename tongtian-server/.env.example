# 复制为 .env 后按需修改；init.sh 启动时会自动加载。
# 生产环境务必配置独立的 JWT 密钥，并将服务放在 TLS 反向代理之后。

# 运行环境：development / production
TT_SERVER_ENV=development
TT_SERVER_HOST=127.0.0.1
TT_SERVER_PORT=8000
# 数据目录（SQLite 与市场包文件），相对路径按启动目录解析
TT_SERVER_DATA_DIR=./storage

# 生产环境必须设置（建议：python -c "import secrets; print(secrets.token_hex(32))"）
TT_SERVER_JWT_SECRET=
TT_ACCESS_TTL_SECONDS=900
TT_REFRESH_TTL_SECONDS=2592000

# 网关短票（M1.3）：服务令牌给网关拉策略用，必须与网关侧 TT_GATEWAY_SERVICE_TOKEN 一致；
# 未配置时 /api/v1/gateway/policy 返回 503。签名密钥自动生成在 {data_dir}/keys/。
# 网关短票受众固定为 tongtian-gateway；有效期上限 900 秒，且不超过 access token 的 exp。
TT_GATEWAY_SERVICE_TOKEN=
TT_GATEWAY_AUDIENCE=tongtian-gateway
TT_GATEWAY_TOKEN_TTL_SECONDS=900
# 签名密钥最长使用时长；到期后下次启动自动轮换（旧钥保留一轮用于宽限）
TT_SERVER_JWT_KEY_MAX_AGE_SECONDS=2592000

# 网关管理代理（M1.4）：/api/v1/admin/gateway/* 由服务端补 X-TT-Admin-Token 后转发到网关。
# 管理令牌只留在这里，不进浏览器、不进页面源码；两项缺一时代理接口返回 503。
TT_GATEWAY_ADMIN_URL=
TT_GATEWAY_ADMIN_TOKEN=
# 网关管理面启用 mTLS（TT_GATEWAY_MTLS_MODE=proxy）且地址为 https 时，控制面出示客户端证书。
# 私钥只放服务端环境，权限仅服务账号可读；CA 留空使用系统信任库。
TT_GATEWAY_ADMIN_CLIENT_CERT=
TT_GATEWAY_ADMIN_CLIENT_KEY=
TT_GATEWAY_ADMIN_CA=
# 代理连网关的超时（秒）
TT_GATEWAY_PROXY_TIMEOUT_SECONDS=10
# 网关用量判重键 (gatewayId, requestId) 的保留天数；清理每小时最多一次
TT_GATEWAY_USAGE_RETENTION_DAYS=30

# 注册开关与跨域来源（多个来源用逗号分隔；生产环境不建议使用 *）
TT_ALLOW_REGISTRATION=true
TT_CORS_ORIGINS=*
TT_TRUST_PROXY=false

# 演示数据：开发阶段默认由 init.sh 开启；设为 false 使用干净数据库
TT_SEED_DEMO=true
# 演示账号密码仅在首次创建时生效；留空则随机生成并打印一次
TT_DEMO_PASSWORD=

# 管理员引导：两者必须同时配置，密码至少 8 位。
# 已存在账号只会被提升为 admin，不会修改其密码与昵称。
TT_ADMIN_EMAIL=
TT_ADMIN_PASSWORD=
TT_ADMIN_NICKNAME=平台管理员

# 套件/技能包校验上限（一般无需调整）
TT_MAX_ZIP_BYTES=16777216
TT_MAX_ZIP_ENTRIES=256
TT_MAX_ENTRY_BYTES=4194304
TT_MAX_UNCOMPRESSED_BYTES=33554432
TT_MAX_MANIFEST_BYTES=262144
TT_MAX_SKILL_MD_BYTES=524288

# Docker 部署（docker-compose.yml）专用：宿主机绑定地址。
# 默认仅本机可访问；直接对外改为 0.0.0.0，并配合 TLS 反向代理使用。
# TT_SERVER_BIND=127.0.0.1
