# 通天办公 (Tauri 版) - 引擎模型配置示例
# 复制为 .env 并填入真实值。.env 已被 git 忽略，不会提交密钥。
#
# TT_PROVIDER: dashscope | openai_compat
#   - dashscope:     通义千问（DashScope），需 TT_API_KEY
#   - openai_compat: 任意 OpenAI 兼容端点（OpenAI/DeepSeek/Kimi/本地 Ollama 等）

TT_PROVIDER=dashscope

# 模型名称（dashscope 常用: qwen-plus / qwen-max / qwen-turbo）
TT_MODEL=qwen-plus

# API Key（必填）
TT_API_KEY=

# 仅 openai_compat 需要：兼容端点 base_url
# 例: DeepSeek https://api.deepseek.com/v1 | Ollama http://127.0.0.1:11434/v1
TT_BASE_URL=

# ── 账号与登录态（网页验证登录） ────────────────────────────
# TT_AUTH_MOCK: 登录 Mock 开关（开发规范）
#   - true（缺省）: 开发自测，登录为模拟用户直登，不发浏览器不起回调
#   - false:        联调阶段，拉起浏览器网页登录 + loopback 回调闭环
TT_AUTH_MOCK=true

# Auth 服务地址（本地过渡实现；云端 Phase A 上线后仅换此 URL）
TT_AUTH_SERVER_URL=http://127.0.0.1:18080

