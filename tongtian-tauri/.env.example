# 通天办公 (Tauri 版) - 引擎模型配置示例
# 复制为 .env 并填入真实值。.env 已被 git 忽略，不会提交密钥。
#
# TT_PROVIDER: dashscope | openai_compat
#   - dashscope:     通义千问（DashScope），需 TT_API_KEY
#   - openai_compat: 任意 OpenAI 兼容端点（OpenAI/DeepSeek/Kimi/本地 Ollama 等）

TT_PROVIDER=dashscope

# 模型名称（dashscope 常用: qwen-plus / qwen-max / qwen-turbo）
TT_MODEL=qwen-plus

# API Key（必填）
TT_API_KEY=

# 仅 openai_compat 需要：兼容端点 base_url
# 例: DeepSeek https://api.deepseek.com/v1 | Ollama http://127.0.0.1:11434/v1
TT_BASE_URL=

# ── 账号与登录态（网页验证登录，默认真实） ──────────────────
# TT_AUTH_MOCK: 登录 Mock 开关（离线开发用）
#   - false（缺省）: 连接综合服务端做真实账号验证（浏览器网页登录 + loopback 回调）
#   - true:          离线自测，直接模拟用户登录，不发浏览器、不连服务端
TT_AUTH_MOCK=false

# 账号 / 协作服务地址（默认综合服务端 tongtian-server）
# 远程地址必须是 HTTPS；本机回环可用 HTTP
TT_AUTH_SERVER_URL=http://127.0.0.1:8000

# ── 联网搜索（Agent 的 web_search 工具） ─────────────────────
# 搜索源本身只是「去哪查」；能不能用还取决于工作区里的联网显式授权
# （设置 → 安全 → 联网白名单必须包含搜索主机，否则工具不注册）。
#   TT_SEARCH_PROVIDER: searxng | tavily | serper
#   - searxng: 自建实例，需 TT_SEARCH_URL（如 https://searx.example.com/search）
#   - tavily:  默认 https://api.tavily.com/search，需 TT_SEARCH_API_KEY
#   - serper:  默认 https://google.serper.dev/search，需 TT_SEARCH_API_KEY
TT_SEARCH_PROVIDER=

# searxng 必填；tavily/serper 可覆盖默认端点
TT_SEARCH_URL=

# tavily / serper 必填
TT_SEARCH_API_KEY=

# TT_SEARCH_MOCK: 本地占位结果，不发真实网络请求（开发规范；仍需联网授权）
TT_SEARCH_MOCK=false

