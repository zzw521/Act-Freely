{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "任我行",
  "mainBinaryName": "tongtian-tauri",
  "version": "0.1.0",
  "identifier": "com.tongtian.office",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:7173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "北京通天云计算有限公司",
    "copyright": "© 2026 北京通天云计算有限公司",
    "resources": {
      "staged-engine": "engine",
      "../scripts/mock-agent.py": "scripts/mock-agent.py",
      "../vendor/python": "python",
      "../../LICENSE": "LICENSE",
      "../../NOTICE": "NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "../../EULA.zh-CN.rtf",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "zh-CN",
        "upgradeCode": "0199CC21-8388-4FDD-967C-D87D4011171F"
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "useLocalToolsDir": true
  }
}
