{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "任我行",
  "mainBinaryName": "tongtian-tauri",
  "version": "0.1.0",
  "identifier": "com.tongtian.office",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:7173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "任我行",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "北京通天云计算有限公司",
    "copyright": "© 2026 北京通天云计算有限公司",
    "resources": {
      "../engine": "engine",
      "../scripts/mock-agent.py": "scripts/mock-agent.py",
      "../vendor/python": "python"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "useLocalToolsDir": true
  }
}
